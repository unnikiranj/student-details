    "app:install": "C:\\Users\\Dell\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe install -r PVPSITStudentApp\\app\\build\\outputs\\apk\\debug\\app-debug.apk",
    "mobile:preview": "start http://localhost/studentdetails/mobile_preview.php"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.0.2",
