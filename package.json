  "description": "Student Details Portal with PHP REST API and Kotlin Android client",
  "main": "index.php",
  "scripts": {
    "build": "node build.js",
    "build:js": "node build-js.js",
    "build:css": "node build-css.js",
    "watch": "node watch.js",
    "test:api": "php test_api_v1.php",
